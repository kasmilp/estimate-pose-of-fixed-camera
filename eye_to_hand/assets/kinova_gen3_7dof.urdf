<?xml version="1.0" ?>
<!--
  Kinova Gen3 (7 DOF) kinematic model.

  Kinematic chain, joint origins and link names are taken from the official
  Kortex description (GEN3_URDF_V12). Visual/collision meshes and inertial
  blocks are removed because this repository only needs forward kinematics
  (getTransform equivalent of the MathWorks `kinovaGen3` model).
  Link names kept identical to the MATLAB rigid body tree:
    base_link, Shoulder_Link, HalfArm1_Link, HalfArm2_Link, ForeArm_Link,
    SphericalWrist1_Link, SphericalWrist2_Link, Bracelet_Link, EndEffector_Link
-->
<robot name="kinova_gen3">
  <link name="base_link" />
  <joint name="Actuator1" type="continuous">
    <origin xyz="0 0 0.15643" rpy="3.1416 0 0" />
    <parent link="base_link" />
    <child link="Shoulder_Link" />
    <axis xyz="0 0 1" />
    <limit effort="39" velocity="0.8727" />
  </joint>

  <link name="Shoulder_Link" />
  <joint name="Actuator2" type="revolute">
    <origin xyz="0 0.005375 -0.12838" rpy="1.5708 0 0" />
    <parent link="Shoulder_Link" />
    <child link="HalfArm1_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.41" upper="2.41" effort="39" velocity="0.8727" />
  </joint>

  <link name="HalfArm1_Link" />
  <joint name="Actuator3" type="continuous">
    <origin xyz="0 -0.21038 -0.006375" rpy="-1.5708 0 0" />
    <parent link="HalfArm1_Link" />
    <child link="HalfArm2_Link" />
    <axis xyz="0 0 1" />
    <limit effort="39" velocity="0.8727" />
  </joint>

  <link name="HalfArm2_Link" />
  <joint name="Actuator4" type="revolute">
    <origin xyz="0 0.006375 -0.21038" rpy="1.5708 0 0" />
    <parent link="HalfArm2_Link" />
    <child link="ForeArm_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.66" upper="2.66" effort="39" velocity="0.8727" />
  </joint>

  <link name="ForeArm_Link" />
  <joint name="Actuator5" type="continuous">
    <origin xyz="0 -0.20843 -0.006375" rpy="-1.5708 0 0" />
    <parent link="ForeArm_Link" />
    <child link="SphericalWrist1_Link" />
    <axis xyz="0 0 1" />
    <limit effort="9" velocity="0.8727" />
  </joint>

  <link name="SphericalWrist1_Link" />
  <joint name="Actuator6" type="revolute">
    <origin xyz="0 0.00017505 -0.10593" rpy="1.5708 0 0" />
    <parent link="SphericalWrist1_Link" />
    <child link="SphericalWrist2_Link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.23" upper="2.23" effort="9" velocity="0.8727" />
  </joint>

  <link name="SphericalWrist2_Link" />
  <joint name="Actuator7" type="continuous">
    <origin xyz="0 -0.10593 -0.00017505" rpy="-1.5708 0 0" />
    <parent link="SphericalWrist2_Link" />
    <child link="Bracelet_Link" />
    <axis xyz="0 0 1" />
    <limit effort="9" velocity="0.8727" />
  </joint>

  <link name="Bracelet_Link" />
  <joint name="EndEffector" type="fixed">
    <origin xyz="0 0 -0.061525" rpy="3.14159265358979 0 0" />
    <parent link="Bracelet_Link" />
    <child link="EndEffector_Link" />
  </joint>

  <link name="EndEffector_Link" />
</robot>
